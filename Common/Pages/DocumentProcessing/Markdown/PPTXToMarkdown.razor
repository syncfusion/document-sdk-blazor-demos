@page "/markdown/PPTXToMarkdown"
@inject Microsoft.JSInterop.IJSRuntime JS
@using System.IO
@using Syncfusion.Blazor.Buttons
@using BlazorDemos.Data.DocumentProcessing.Markdown
@inject HttpClient Http
@*Hidden:Lines*@
@inherits SampleBaseComponent
@inject NavigationManager NavigationManager
@*End:Hidden*@

<SampleDescription>
    <p style="font-size:16px">This sample demonstrates how to convert the PowerPoint presentation to Markdown using .NET PowerPoint (Presentation) and .NET Markdown libraries.</p>
</SampleDescription>
<ActionDescription>
 <p style="font-size:16px">The .NET PowerPoint (Presentation) library provides support to convert PowerPoint presentations to Markdown.</p>
 <p><ul style="font-size:16px"><li>You can convert existing PPTX documents or those created using the .NET PowerPoint (Presentation) library to Markdown.</li><li>You can convert text, tables, hyperlinks, list, and images from PPTX documents to Markdown.</li><li>You can customize the image path while exporting to Markdown.</li></ul></p>
 <p style="font-size:16px">More information about PowerPoint to Markdown conversion can be found in this <a href="https://help.syncfusion.com/document-processing/powerpoint/conversions/powerpoint-to-markdown" aria-label="documentation section">documentation</a> section.</p>
</ActionDescription>

<div class="control-section">
    <p style="font-size:16px">Click the button to view the Markdown document generated using the .NET PowerPoint (Presentation) and .NET Markdown libraries. Please note that a text editor or Markdown Viewer is required to view the Markdown document.</p>
    <div class="button-section">
        <div id="button-control">
            <div class="row">
                <div>
                    <SfButton @onclick="ViewTemplate">View Template</SfButton>&nbsp;
                    <SfButton @onclick="ConvertToMarkdown">Convert To Markdown</SfButton>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .control-section .row {
        margin: 10px 0;
    }
</style>

@code {
    MemoryStream? documentStream;
    string uploadedFileName = "presentation-to-markdown.pptx";
    //Hidden:Lines

    Dictionary<string, FileStream> fileData = new Dictionary<string, FileStream>();

    //End:Hidden

    /// <summary>
    /// Convert the PowerPoint presentation to Markdown
    /// </summary>
    public async Task ConvertToMarkdown(MouseEventArgs args)
    {
        await LoadTemplate();
        PPTXToMarkdownService service = new PPTXToMarkdownService(fileData);
        documentStream = service.PPTXToMarkdown("ConvertToMarkdown");
        service.Close();
        await JS.SaveAs("presentation-to-markdown.md", documentStream.ToArray());
    }
    /// <summary>
    /// Download the template PowerPoint presentation
    /// </summary>
    public async Task ViewTemplate(MouseEventArgs args)
    {
        await LoadTemplate();
        PPTXToMarkdownService service = new PPTXToMarkdownService(fileData);
        documentStream = service.PPTXToMarkdown("View Template");
        service.Close();
        await JS.SaveAs("presentation-to-markdown.pptx", documentStream.ToArray());
    }

    public FileStream ByteArrayToFileStream(byte[] bytes)
    {
        string tempPath = uploadedFileName;
        FileStream fileStream = new FileStream(tempPath, FileMode.Create, FileAccess.ReadWrite, FileShare.None, 4096, FileOptions.DeleteOnClose);
        fileStream.Write(bytes, 0, bytes.Length);
        fileStream.Position = 0;
        return fileStream;
    }

    /// <summary>
    /// Load the template document
    /// </summary>
    public async Task LoadTemplate()
    {
        if (fileData != null && fileData.Count == 0 && SampleService?.WebAssetsPath != null)
        {
            string fileDataPath = NavigationManager.BaseUri + SampleService.WebAssetsPath;
            byte[] data = await Http.GetByteArrayAsync(fileDataPath + "data/markdown/presentation-to-markdown.pptx");
            fileData.Add("presentation-to-markdown.pptx", ByteArrayToFileStream(data));
            uploadedFileName = "presentation-to-markdown.pptx";
        }
    }
}
