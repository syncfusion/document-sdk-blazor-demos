@page "/excel/excel-to-markdown"
@inject Microsoft.JSInterop.IJSRuntime JS
@inject HttpClient Http
@using System.IO;

@using Syncfusion.Blazor.Buttons
@*Hidden:Lines*@

@using BlazorDemos.Data.FileFormats.XlsIO

@*End:Hidden*@
@*Hidden:Lines*@
@inherits SampleBaseComponent
@inject NavigationManager NavigationManager


@*End:Hidden*@

<SampleDescription>
    <p>This sample demonstrates how to convert spreadsheets to Markdown documents using XlsIO.</p>
</SampleDescription>
<ActionDescription>
    <p>This sample illustrates the conversion of a MS Excel document to a Markdown document format.</p>
    <p style='display: block'>Essential XlsIO allows to export the Excel document into Markdown document.</p>
    <p style='display: block'><b>Features:</b></p>
    <ul>
        <li>Supports conversion of Excel documents to Markdown format that includes text, numbers, formulas, number formatting, and images.</li>
    </ul>
</ActionDescription>

<div class="control-section">
    <p style="font-weight:normal">Click the button to view the Markdown document converted from the Excel document using Essential XlsIO. Please note that a text editor or Markdown Viewer is required to view the Markdown document.</p>
    <div class="button-section">
        <div id="button-control">
            <div class="row">
                <div>
                    <SfButton @onclick="InputTemplate">Input Template</SfButton>&nbsp;
                    <SfButton @onclick="ConvertExcelToMarkDown">Convert To Markdown</SfButton>
                </div>
            </div>
        </div>
    </div>
</div>

<style>   
    .control-section .row {
        margin: 10px 0;
    }
    .e-radio-wrapper {
    width:250px;
    margin-right: 20px;
    }
</style>

@code {
    MemoryStream excelStream;
    //Hidden:Lines
    
    Dictionary<string, MemoryStream> fileData = new Dictionary<string, MemoryStream>();

    //End:Hidden

    /// <summary>
    /// Create and download the simple Excel document
    /// </summary>
    public async Task ConvertExcelToMarkDown()
    {
        string fileDataPath = NavigationManager.BaseUri + SampleService.WebAssetsPath;
        byte[] data = await Http.GetByteArrayAsync(fileDataPath + "data/xlsio/excel-to-markdown.xlsx");
        fileData.Add("excel-to-markdown.xlsx", new MemoryStream(data));
        ExcelToMarkdownService service = new ExcelToMarkdownService(fileData);
        excelStream = service.ExcelToMarkdownXlsIO("Markdown");
        service.Close();
        await JS.SaveAs("ExcelToMarkdown.md", excelStream.ToArray());
    }
    /// <summary>
    /// Create and download the simple Excel document
    /// </summary>
    public async Task InputTemplate()
    {
        string fileDataPath = NavigationManager.BaseUri + SampleService.WebAssetsPath;
        byte[] data = await Http.GetByteArrayAsync(fileDataPath + "data/xlsio/excel-to-markdown.xlsx");
        fileData.Add("excel-to-markdown.xlsx", new MemoryStream(data));
        ExcelToMarkdownService service = new ExcelToMarkdownService(fileData);
        excelStream = service.ExcelToMarkdownXlsIO("Input Template");
        service.Close();
        await JS.SaveAs("InputTemplate.xlsx", excelStream.ToArray());
    }
}
