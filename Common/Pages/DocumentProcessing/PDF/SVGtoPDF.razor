@page "/pdf/svg-to-pdf"
@inject Microsoft.JSInterop.IJSRuntime JS
@using System.IO
@using Syncfusion.Blazor.Buttons
@inject HttpClient Http
@*Hidden:Lines*@
@inherits SampleBaseComponent

@using BlazorDemos.Data.FileFormats.PDF

@*End:Hidden*@
@*Hidden:Lines*@
@inject NavigationManager NavigationManager


@*End:Hidden*@

<SampleDescription>
    <p style="font-size:16px">This sample demonstrates how to convert an SVG file to a PDF document using Essential PDF.</p>
</SampleDescription>
<ActionDescription>
    <p style="font-size:16px">More information about SVG to PDF document can be found in this documentation <a target='_blank' href='https://help.syncfusion.com/file-formats/pdf/working-with-document-conversions#converting-svg-to-pdf' aria-label="documentation section">section.</a></p>
</ActionDescription>

<div class="control-section">
    <p style="font-size:16px">Click the button to view a PDF document generated by Essential PDF. Please note that Adobe Reader or its equivalent is required to view the resultant document. </p>
   
    <div class="button-section">
        <div id="button-control">
            <div class="row">
                <div>
                     <SfButton @onclick="ConvertPDF">Convert To PDF</SfButton>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .radio-control {
        margin: 0 0 5% 0;
    }    

    .control-section .row {
        margin: 10px 0;
    }
</style>

@code {
    
    
    /// <summary>
    /// Create and download the simple PDF document
    /// </summary>
    public async void ConvertPDF(MouseEventArgs args)
    {	   
        Dictionary<string, MemoryStream> fileData = new Dictionary<string, MemoryStream>();
        string fileDataPath = NavigationManager.BaseUri + SampleService?.WebAssetsPath;
        byte[] data = await Http.GetByteArrayAsync(fileDataPath + "images/pdf/svg-to-pdf.svg");
        fileData.Add("svg-to-pdf.svg", new MemoryStream(data));
        SVGtoPDFService service = new SVGtoPDFService(fileData);
        MemoryStream documentStream = service.ConvertPdfDocument();
        service.Close();
        await JS.SaveAs("SVGtoPDF.pdf", documentStream.ToArray());
    }
}